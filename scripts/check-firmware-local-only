#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

compile_db="firmware/build/compile_commands.json"
if [[ ! -f "$compile_db" ]]; then
  echo "Missing $compile_db. Run npm run firmware:build first." >&2
  exit 1
fi

legacy_source_regex='firmware/main/apps/app_(ai_agent|app_center|avatar|dance|espnow_ctrl|ezdata|launcher|setup|template)/|firmware/main/hal/hal_(account|app_center|espnow|ezdata|mcp|ota|ws_avatar)\.cpp|firmware/main/vendor/embedded_runtime/(application|mcp_server|ota)\.cc|firmware/main/vendor/embedded_runtime/protocols/(mqtt_protocol|websocket_protocol)\.cc|firmware/main/vendor/embedded_runtime/boards/common/(dual_network_board|esp32_camera|esp_video|ml307_board|nt26_board|press_to_talk_mcp_tool|rndis_board|sleep_timer)\.cc'
legacy_hal_include_regex='#include [<"]hal/|#include "drivers/|#include "utils/'

for legacy_dir in \
  firmware/main/hal \
  firmware/main/embedded_runtime \
  firmware/main/local_runtime_adapters \
  firmware/main/robot_expression_motion_runtime \
  firmware/main/runtime_compat; do
  if [[ -d "$legacy_dir" ]]; then
    echo "Legacy $legacy_dir directory must not exist. Move code into system, hardware, sensors, services, vendor, or system/runtime_bridge." >&2
    exit 1
  fi
done

if rg -n 'firmware/main/(embedded_runtime|local_runtime_adapters|robot_expression_motion_runtime|runtime_compat)' firmware/main --glob '*.{h,hpp,c,cc,cpp,txt,md}' CMakeLists.txt 2>/dev/null; then
  echo "Legacy runtime directory path found in firmware/main." >&2
  exit 1
fi

if rg -n "$legacy_hal_include_regex|#include [<\"](embedded_runtime|local_runtime_adapters|robot_expression_motion_runtime|runtime_compat)/" firmware/main --glob '*.{h,hpp,c,cc,cpp}'; then
  echo "Legacy include path found in firmware/main." >&2
  exit 1
fi

if rg -n "$legacy_source_regex" "$compile_db"; then
  echo "Legacy cloud sources are still present in the firmware compile database." >&2
  exit 1
fi

if ! rg -q 'STACKCHAN_LOCAL_DISABLE_LEGACY_CLOUD=1|STACKCHAN_LOCAL_DISABLE_LEGACY_CLOUD' "$compile_db"; then
  echo "STACKCHAN_LOCAL_DISABLE_LEGACY_CLOUD is missing from firmware compile flags." >&2
  exit 1
fi

if ! rg -q 'firmware/main/system/runtime_bridge/application_local_stub\.cc' "$compile_db"; then
    echo "Local Application stub is missing from the firmware compile database." >&2
    exit 1
fi

if rg -q 'firmware/xiaozhi-esp32/' "$compile_db"; then
  echo "Build still references the external xiaozhi-esp32 checkout." >&2
  exit 1
fi

for file in firmware/main/idf_component.yml firmware/dependencies.lock; do
  if rg -n '78/esp-ml307|78/uart-eth-modem|esp-now' "$file"; then
    echo "Legacy network/control dependency found in $file." >&2
    exit 1
  fi
done

echo "Firmware local-only compile guard passed."
