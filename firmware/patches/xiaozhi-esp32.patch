diff --git a/main/audio/demuxer/ogg_demuxer.cc b/main/audio/demuxer/ogg_demuxer.cc
index 6b60876..58e1cba 100644
--- a/main/audio/demuxer/ogg_demuxer.cc
+++ b/main/audio/demuxer/ogg_demuxer.cc
@@ -3,6 +3,86 @@
 
 #define TAG "OggDemuxer"
 
+namespace {
+
+int get_opus_samples_per_frame(const uint8_t* data, int sample_rate)
+{
+    if ((data[0] & 0x80) != 0) {
+        int audiosize = (data[0] >> 3) & 0x03;
+        return (sample_rate << audiosize) / 400;
+    }
+
+    if ((data[0] & 0x60) == 0x60) {
+        return (data[0] & 0x08) != 0 ? sample_rate / 50 : sample_rate / 100;
+    }
+
+    int audiosize = (data[0] >> 3) & 0x03;
+    return audiosize == 3 ? sample_rate * 60 / 1000 : (sample_rate << audiosize) / 100;
+}
+
+int get_opus_frame_count(const uint8_t* data, size_t len)
+{
+    if (len == 0) {
+        return 0;
+    }
+
+    switch (data[0] & 0x03) {
+        case 0:
+            return 1;
+        case 1:
+        case 2:
+            return 2;
+        case 3:
+            return len >= 2 ? data[1] & 0x3F : 0;
+        default:
+            return 0;
+    }
+}
+
+int normalize_opus_duration_ms(int duration_ms)
+{
+    if (duration_ms <= 7) {
+        return 5;
+    }
+    if (duration_ms <= 15) {
+        return 10;
+    }
+    if (duration_ms <= 30) {
+        return 20;
+    }
+    if (duration_ms <= 50) {
+        return 40;
+    }
+    if (duration_ms <= 70) {
+        return 60;
+    }
+    if (duration_ms <= 90) {
+        return 80;
+    }
+    if (duration_ms <= 110) {
+        return 100;
+    }
+    return 120;
+}
+
+int get_opus_packet_duration_ms(const uint8_t* data, size_t len, int sample_rate)
+{
+    if (data == nullptr || len == 0 || sample_rate <= 0) {
+        return 60;
+    }
+
+    const int frame_count = get_opus_frame_count(data, len);
+    const int samples_per_frame = get_opus_samples_per_frame(data, sample_rate);
+    if (frame_count <= 0 || samples_per_frame <= 0) {
+        return 60;
+    }
+
+    const int duration_ms = samples_per_frame * frame_count * 1000 / sample_rate;
+    return normalize_opus_duration_ms(duration_ms);
+}
+
+}  // namespace
