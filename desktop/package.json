{
  "name": "@stackchan-local/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "predev": "npm run build -w @stackchan-local/protocol && npm run preview:build",
    "dev": "tsx src/index.ts",
    "premcp": "npm run build -w @stackchan-local/protocol && npm run preview:build",
    "mcp": "tsx src/index.ts --mcp",
    "prebuild": "npm run build -w @stackchan-local/protocol",
    "build": "npm run preview:build && tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @stackchan-local/protocol",
    "typecheck": "npm run preview:typecheck && tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @stackchan-local/protocol",
    "test": "npm run preview:build && vitest run",
    "preview:build": "vite build --config preview-ui/vite.config.ts",
    "preview:typecheck": "tsc -p preview-ui/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "@stackchan-local/protocol": "file:../protocol",
    "bonjour-service": "^1.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.14"
  }
}
