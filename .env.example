# StackChan Local desktop daemon
STACKCHAN_LOCAL_HOST=0.0.0.0
STACKCHAN_LOCAL_PORT=8787

# WebUI dashboard
STACKCHAN_PREVIEW_ENABLED=1
STACKCHAN_PREVIEW_HOST=127.0.0.1
STACKCHAN_PREVIEW_PORT=8788

# Change this before using real hardware.
STACKCHAN_PAIRING_TOKEN=dev-local-token
STACKCHAN_ADVERTISE_MDNS=1

# Codex companion state mirror
STACKCHAN_CODEX_STATUS=1
# STACKCHAN_CODEX_SESSIONS_ROOT=/path/to/.codex/sessions

# Camera-based face tracking
STACKCHAN_FACE_TRACKING=0
STACKCHAN_FACE_TRACKING_PYTHON=python3
STACKCHAN_FACE_TRACKING_CAMERA_PRESET=fast
STACKCHAN_FACE_LANDMARKER_MODEL=desktop/models/face_landmarker.task
STACKCHAN_FACE_TRACKING_MAX_FACES=1
STACKCHAN_FACE_TRACKING_MIN_DETECTION_CONFIDENCE=0.18
STACKCHAN_FACE_TRACKING_MIN_PRESENCE_CONFIDENCE=0.18
STACKCHAN_FACE_TRACKING_MIN_TRACKING_CONFIDENCE=0.18
STACKCHAN_FACE_TRACKING_MIRROR_X=false
STACKCHAN_FACE_TRACKING_SPEED=700
STACKCHAN_FACE_TRACKING_DEADBAND=0.018
STACKCHAN_FACE_TRACKING_YAW_KP=44
STACKCHAN_FACE_TRACKING_YAW_KI=0
STACKCHAN_FACE_TRACKING_YAW_KD=0
STACKCHAN_FACE_TRACKING_PITCH_KP=32
STACKCHAN_FACE_TRACKING_PITCH_KI=0
STACKCHAN_FACE_TRACKING_PITCH_KD=0
STACKCHAN_FACE_TRACKING_INTEGRAL_LIMIT=0.25
STACKCHAN_FACE_TRACKING_OUTPUT_LIMIT_DEG=20

# Optional completion TTS. Disabled by default.
STACKCHAN_VOLCENGINE_TTS_ENABLED=0
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_VOICE_ID=zh_male_liangsangmengzai_uranus_bigtts
VOLCENGINE_TTS_SAMPLE_RATE=16000
STACKCHAN_CODEX_COMPLETION_TTS_TEXT=Codex task finished.
STACKCHAN_CODEX_COMPLETION_TTS_VOLUME=80

STACKCHAN_LOG_LEVEL=info
